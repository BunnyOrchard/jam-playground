# GLO keeps the song. PLAY is the conductor. SAVE is the break, not an empty breakdown.
# FX opens the effects page, and a second press closes it. Black keys then hold an effect.
# A key that comes up lets the line go.
seed 42
reboot
wait 40
tap GLO
wait 80
expect iam 0
expect playing 1
expect sec 0
expect iamauto 1
tap PLAY
wait 40
expect playing 1
expect iamauto 0
expect sec 0
expect toast MANUAL
expect toast2 YOURS
tap PLAY
wait 40
expect playing 1
expect iamauto 1
expect sec 0
expect toast AUTO
expect toast2 CONDUCTING
tap SAVE
wait 80
expect toast BAR: BREAK
expect sec 0
expect playing 1
expect iam 0
wait 1800
expect sec 0
expect iamsec 3
expect playing 1
expect iam 0
expect sixteenths >12
press SAVE
wait 600
release SAVE
wait 40
expect sec 0
expect playing 1
expect iam 0
expect toast BAR: BREAK
tap FX
wait 40
expect fxon 1
expect toast FX
expect toast2 HOLD A KEY
expect playing 1
expect sec 0
tap FX
wait 40
expect fxon 0
expect toast FX
expect toast2 OFF
expect playing 1
expect sec 0
key b0 down
wait 40
expect fxmask >0
expect held 0
expect fxon 0
key b0 up
wait 40
expect fxmask 0
expect held 0
key w0 down
wait 40
expect held >0
key w0 up
wait 40
expect held 0
expect iam 0
expect playing 1
expect sec 0
wait 400
expect sixteenths >16
expect iam 0
expect playing 1
# A key still down when GLO closes does not keep the line, and the groove stays.
key w0 down
wait 40
expect held >0
tap GLO
wait 80
expect iam 1
expect held 0
expect playing 1
expect sec 0
key w0 up
wait 40
expect held 0
expect playing 1
