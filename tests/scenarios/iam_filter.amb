# GLO's sixth black key holds the echo throw. It drops on release, and it does not
# edit the song, the echo, or the scale. The tenth key is the low-pass.
seed 42
reboot
wait 40
tap GLO
wait 80
expect iam 0
expect fxmask 0
expect pool 0x6AD
key b5 down
wait 40
expect fxmask 262144
expect litkeys 8192
expect pool 0x6AD
expect iammask 65
expect par67 40
expect par92 3
expect iamstyle 0
expect iamsec 0
peakreset
wait 700
expect peak_db_max -0.5
key b5 up
wait 80
expect fxmask 0
expect litkeys 0
expect iammask 65
expect par67 40
expect iamstyle 0
expect iamsec 0
key b9 down
wait 40
expect fxmask 16384
key b9 up
wait 40
expect fxmask 0
