# GLO's eighth black key holds a flange. It drops on release, and it does not
# edit the song, the echo, or the scale.
seed 42
reboot
wait 40
tap GLO
wait 80
expect iam 0
expect fxmask 0
expect pool 0x6AD
key b7 down
wait 40
expect fxmask 134217728
expect litkeys 131072
expect pool 0x6AD
expect iammask 65
expect par67 40
expect par92 3
expect iamstyle 0
expect iamsec 0
peakreset
wait 700
expect peak_db_max -0.5
key b7 up
wait 80
expect fxmask 0
expect litkeys 0
expect iammask 65
expect par67 40
expect iamstyle 0
expect iamsec 0
