# GLO's effects page. Fourteen keys are crowd effects. The second black key
# stays the eighth gate, and the first white key stays the half-note repeat.
# With the page closed, the first black key is still the jam repeat.
seed 42
reboot
wait 40
tap GLO
wait 80
expect iam 0
tap FX
wait 40
expect fxon 1
expect djmask 0
expect fxmask 0

key b0 down
wait 40
expect djmask 1
expect fxmask 0
expect litkeys 2
key b0 up
wait 40
expect djmask 0
expect fxmask 0

key b3 down
wait 40
expect djmask 2
expect fxmask 0
key b3 up
wait 40
expect djmask 0

key b5 down
wait 40
expect djmask 4
expect fxmask 0
key b5 up
wait 40
expect djmask 0

key b6 down
wait 40
expect djmask 8
expect fxmask 0
key b6 up
wait 40
expect djmask 0

key b7 down
wait 40
expect djmask 16
expect fxmask 0
key b7 up
wait 40
expect djmask 0

key b8 down
wait 40
expect djmask 32
expect fxmask 0
key b8 up
wait 40
expect djmask 0

key b9 down
wait 40
expect djmask 64
expect fxmask 0
key b9 up
wait 40
expect djmask 0

key b10 down
wait 40
expect djmask 128
expect fxmask 0
key b10 up
wait 40
expect djmask 0

key w8 down
wait 40
expect djmask 256
expect fxmask 0
key w8 up
wait 40
expect djmask 0

key w9 down
wait 40
expect djmask 512
expect fxmask 0
key w9 up
wait 40
expect djmask 0

key w10 down
wait 40
expect djmask 1024
expect fxmask 0
key w10 up
wait 40
expect djmask 0

key w11 down
wait 40
expect djmask 2048
expect fxmask 0
key w11 up
wait 40
expect djmask 0

key w12 down
wait 40
expect djmask 4096
expect fxmask 0
key w12 up
wait 40
expect djmask 0

key w13 down
wait 40
expect djmask 8192
expect fxmask 0
key w13 up
wait 40
expect djmask 0

key b1 down
wait 40
expect fxmask 131072
expect djmask 0
key b1 up
wait 40
expect fxmask 0
expect djmask 0

key w0 down
wait 40
expect fxmask 1
expect djmask 0
key w0 up
wait 40
expect fxmask 0
expect djmask 0

tap FX
wait 40
expect fxon 0
key b0 down
wait 40
expect fxmask >0
expect djmask 0
key b0 up
wait 40
expect fxmask 0

tap FX
wait 40
expect fxon 1
key b0 down
wait 40
press SAVE
wait 40
key b0 up
wait 40
release SAVE
wait 40
expect djmask 1
expect fxmask 0
tap FX
wait 40
expect fxon 0
expect djmask 1
expect fxmask 0
