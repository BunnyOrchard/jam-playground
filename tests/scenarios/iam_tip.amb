# Hold SEL and play a part: solo, and the song stays up.
tap PLAY
wait 40
expect iamauto 1
press SEL
wait 30
key w0 down
wait 40
release SEL
wait 40
key w0 up
wait 40
expect litbtn 1024
expect iammask 65
