# Hold a key: its name, and the sound or kit knob 1 is aiming at.
# The name moves before the bar. Knob 1 does not cover it with a toast.
seed 42
reboot
wait 1500
expect toaston 0
key w0 down
wait 80
expect hold PAD
expect hold2 VOICES
expect holdlvl 62
spin K1 1
wait 30
expect hold PAD
expect hold2 STRINGS
expect toaston 0
expect par10 1
spin K1 -1
wait 30
expect hold2 VOICES
key w0 up
wait 40
expect hold
expect hold2

# Knob 2 leans this key's notes, heard now. The rhythm stays, and it does not turn the key on.
key w0 down
wait 80
spin K2 1
wait 30
expect toast MELODY
expect toast2 1
expect toaston 1
expect iammel0 1
expect par11 30
expect par10 1
expect iamgate0 65535
expect iammask 65
expect hold PAD
spin K2 -1
wait 30
expect toast MELODY
expect toast2 0
expect iammel0 0
expect iamgate0 65535
expect par11 30
key w0 up
wait 1400
expect toaston 0

# The kick's kit. Seed 42 opens on House. One step aims at Techno.
key b0 down
wait 80
expect hold KICK
expect hold2 HOUSE
spin K1 1
wait 30
expect hold KICK
expect hold2 TECHNO
expect toaston 0
spin K1 -1
wait 30
expect hold2 HOUSE
key b0 up
wait 40

# Glass is the key's name. Knob 1 still walks the pad's sound.
key w4 down
wait 80
expect hold GLASS
expect hold2 VOICES
expect holdlvl 62
spin K1 3
wait 30
expect hold GLASS
expect hold2 ORGAN
expect toaston 0
spin K1 -3
wait 30
expect hold2 VOICES
key w4 up
wait 40

# The fourth key. Knob 1 is the noise colour. Seed 42 is wood, then vinyl.
key w3 down
wait 80
expect hold DUST
expect hold2 WOOD
spin K1 1
wait 30
expect hold2 VINYL
expect toaston 0
spin K1 -1
wait 30
expect hold2 WOOD
key w3 up
wait 40

# House. Holding Pluck names the acid that is in the song. Letting go adds Pluck beside it.
spin PRESET 7
wait 4000
expect iamstyle 7
expect iammask 0x16
key w12 down
wait 80
expect hold PLUCK
expect hold2 BELL
key w12 up
wait 2500
expect iamlay 264
expect par40 11
expect par1 48
expect iammask 0x16

# The boot song again. Shape and a held FX click, after the house song has had its own clock.
seed 42
reboot
wait 1500
expect toaston 0
expect iammask 65
expect par11 30
expect par22 22
expect par25 53
expect par51 50
expect lane0 256
expect iamgate0 65535

# Bass is dark. Knob 2 leans its notes, and the turn does not wake it.
key w1 down
wait 80
spin K2 1
wait 30
expect toast MELODY
expect toast2 1
expect iammel1 1
expect par25 53
expect iammask 65
expect iamgate1 65535
spin K2 -1
wait 30
expect toast MELODY
expect toast2 0
expect iammel1 0
expect iamgate1 65535
expect par25 53
key w1 up
wait 1500
expect iammask 65

# The fourth key. Knob 2 leans its notes. Tone and the duck stay where the song left them.
key w3 down
wait 80
spin K2 1
wait 30
expect toast MELODY
expect toast2 1
expect iammel3 1
expect par22 22
expect par21 14
expect iamgate3 43690
spin K2 -1
wait 30
expect toast MELODY
expect toast2 0
expect iammel3 0
expect iamgate3 43690
expect par22 22
key w3 up
wait 40

# The kick. Knob 2 leans its notes. The pattern stays, and the kick stays off.
key b0 down
wait 80
spin K2 1
wait 30
expect toast MELODY
expect toast2 1
expect iamdmel0 1
expect par51 50
expect lane0 256
spin K2 -1
wait 30
expect toast MELODY
expect toast2 0
expect iamdmel0 0
expect lane0 256
key b0 up
wait 40

# FX on the pad mutates the pad. The other rows stay, and letting go is not also a tap.
key w0 down
wait 80
tap FX
wait 40
expect toast PAD
expect toast2 MUTATE
expect iamgate0 17476
expect iamgate1 65535
expect iamgate2 65535
expect iamgate3 43690
expect par10 2
expect iammask 65
expect tempo 173
key w0 up
wait 1500
expect iammask 65
expect iamlay 0

# FX on the kick steps that pattern. The groove has already stepped it once.
# The kick stays off, and the pad row stays.
key b0 down
wait 80
tap FX
wait 40
expect toast KICK
expect toast2 MUTATE
expect lane0 65
expect iamgate0 17476
expect par51 50
expect iammask 65
key b0 up
wait 1500
expect iammask 65

# A named key mutates the engine it plays, and the toast says the key.
key w4 down
wait 80
tap FX
wait 40
expect toast GLASS
expect toast2 MUTATE
expect iamgate0 43690
expect iamgate1 65535
expect iammask 65
key w4 up
wait 1500
expect iammask 65
expect iamlay 0

# The stored level stays on the name row. Knob 3 moves it, and it is still there
# once the toast has gone.
key w0 down
wait 80
expect hold PAD
expect holdlvl 62
spin K3 1
wait 30
expect toast PAD 66%
expect holdlvl 66
wait 1400
expect toaston 0
expect hold PAD
expect holdlvl 66
expect iamlvl0 66
key w0 up
wait 40

# A line above the steps tracks the bar. It follows the sixteenth after the
# picture has stopped changing, and it goes when the key does.
key w0 down
wait 80
barwait
wait 400
expect playhead 1
expect hold PAD
key w0 up
wait 40
expect playhead 0
key b0 down
wait 80
wait 300
expect playhead 1
expect hold KICK
key b0 up
wait 40
expect playhead 0

# Seed 42 stores the kick's House kit on the crash. That cymbal is gone, so the
# crash stands in as Techno, and one detent steps over every kit that has none.
key b10 down
wait 80
expect hold CRASH
expect hold2 TECHNO
spin K1 1
wait 30
expect hold2 BREAK
spin K1 1
wait 30
expect hold2 MINIMAL
spin K1 1
wait 30
expect hold2 909
spin K1 1
wait 30
expect hold2 DUSTY
spin K1 1
wait 30
expect hold2 TECHNO
spin K1 -1
wait 30
expect hold2 DUSTY
key b10 up
wait 40

# Holding a key, ALGORITHM mutates that key's track. The scale stays. The key stays.
seed 42
reboot
wait 40
expect par72 1
expect par10 1
expect iamgate0 65535
expect lane0 256
expect iammask 65
key w0 down
wait 80
spin ALGO 1
wait 30
expect toast MUTATE
expect toast2
expect hold PAD
expect par72 1
expect par10 2
expect iamgate0 60095
expect iamgate1 65535
expect iamgate3 43690
expect lane3 21845
expect iammask 65
key w0 up
wait 40
expect iammask 65
expect par10 2
key b0 down
wait 80
spin ALGO 1
wait 30
expect toast MUTATE
expect lane0 11914
expect par72 1
expect par10 2
expect iamgate0 60095
expect iammask 65
spin ALGO -1
wait 30
expect toast MUTATE
expect lane0 416
expect iammask 65
key b0 up
wait 40
expect iammask 65
expect lane0 416
