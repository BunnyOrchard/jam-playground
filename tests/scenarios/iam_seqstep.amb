# Crash stays on the hit it had. Knob 2 leans that hit up the scale, then back.
seed 42
reboot
wait 40
tapkey b10
barwait
tap SEQ
expect iamseq 1
spin SELECT 3
wait 30
expect toast CRASH
expect stepv10 0
spin K2 1
wait 30
expect toast MELODY
expect toast2 1
expect iamdmel10 1
expect stepv10 0
expect iamhel 0
expect iamwob0 0
spin K2 -1
wait 30
expect toast MELODY
expect toast2 0
expect iamdmel10 0
expect stepv10 0
